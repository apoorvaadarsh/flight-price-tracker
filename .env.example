# Trip search (IATA codes; lists use [a, b, c])
ORIGIN=BLR
DESTINATIONS=[DEL, HDO, JAI, AGR, GWL]
DEPART_DATE_START=2026-10-30
DEPART_DATE_END=2026-11-05
MAX_PRICE=12000

# Notifications (same list format; single recipient still uses brackets)
NOTIFY_EMAILS=[you@example.com]
DRY_RUN=false

# Secrets / delivery
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev
CRON_SECRET=generate-a-long-random-string
